# CANDiY API 설정
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# 개발자 대시보드 > API Key 관리 에서 발급 (권한 전체 체크)
# https://developer.candiy.io/user/api-key
CANDIY_API_KEY=

# 선택 — 기본값 https://api.candiy.io
# CANDIY_API_BASE_URL=https://api.candiy.io

# 선택 — 응답 대기 한도(ms). 기본 290000 (간편인증 만료 4분 30초보다 약간 김)
# 배포 환경의 서버리스 함수 최대 실행 시간이 더 짧으면 그에 맞춰 낮추세요.
# CANDIY_TIMEOUT_MS=290000
